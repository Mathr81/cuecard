# Étape 3 : recherche de titres et récupération des sous-titres
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=

# Étape 4 : sens en contexte
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optionnel : miroir auto-hébergé de l'API de dictionnaire (la publique limite
# le débit). Par défaut : https://api.dictionaryapi.dev/api/v2/entries/en
DICTIONARY_API_URL=

# --- Déploiement Docker ---
# Interface d'écoute. 127.0.0.1 par défaut : l'app n'a aucune authentification,
# ne l'ouvre sur 0.0.0.0 que derrière un pare-feu ou un proxy qui la protège.
CUECARD_BIND=127.0.0.1
CUECARD_PORT=3000

# Uniquement pour le profil `https` (Caddy + Let's Encrypt) :
CUECARD_DOMAIN=
# Identifiants pour l'authentification basique, format : utilisateur <hash>
CUECARD_BASIC_AUTH=
