# Recherche de titres, saisons et épisodes. Seule clé nécessaire aux
# sous-titres : ils viennent de sources sans clé ni quota.
TMDB_API_KEY=

# Sens en contexte
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- Dictionnaire ---
# Trois sources sont interrogées dans l'ordre, la suivante ne servant que si la
# précédente tombe. Par défaut :
#   freedictionary  Wiktionary via freedictionaryapi.com : rapide, phonétique,
#                   exemples, et il comprend « wolves » comme « pull off »
#   datamuse        api.datamuse.com : définitions plus sèches, hébergement
#                   indépendant — c'est là son intérêt
#   dictionaryapi   api.dictionaryapi.dev : la seule à fournir un enregistrement
#                   audio, mais lente et souvent en panne, d'où sa dernière place
# Pour retrouver l'audio en priorité, remonter dictionaryapi en tête.
# DICTIONARY_SOURCES=freedictionary,datamuse,dictionaryapi

# Optionnel : miroirs auto-hébergés, si un jour une source publique lâche pour
# de bon. Laisser commenté pour utiliser les URL publiques.
# FREEDICTIONARY_API_URL=https://mon-miroir.exemple/api/v1/entries/en
# DICTIONARY_API_URL=https://mon-miroir.exemple/api/v2/entries/en
# DATAMUSE_API_URL=https://mon-miroir.exemple/words

# --- Déploiement Docker ---
# Nom du réseau Docker partagé avec Nginx Proxy Manager, celui que `docker
# network ls` affiche pour sa stack (souvent « npm » ou
# « nginx-proxy-manager_default »). NPM pointe ensuite sur cuecard:3000.
CUECARD_NETWORK=npm
